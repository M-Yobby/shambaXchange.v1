/* styles/dashboard.css - dashboard-specific styles (crop progress, quick actions, learning hub etc.) */
.weather-alert{background:linear-gradient(135deg,var(--weather-alert) 0%,#64B5F6 100%);color:white;border-left:5px solid #0D47A1;padding:15px;border-radius:8px;display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.dashboard-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;}
.crop-item{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;padding-bottom:15px;border-bottom:1px solid #eee;}
.crop-image{width:50px;height:50px;border-radius:10px;object-fit:cover;}
.crop-name{font-weight:600;}
.crop-progress{width:100%;height:8px;background:#e0e0e0;border-radius:4px;margin-top:5px;overflow:hidden;}
.progress-bar{height:100%;border-radius:4px;}
.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
.action-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;background:#f5f5f5;border-radius:12px;cursor:pointer;}
.action-btn i{font-size:1.6rem;margin-bottom:8px;color:var(--primary);}
.recommendation{display:flex;gap:12px;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #eee;}
.recommendation-icon{font-size:1.4rem;color:var(--accent);flex-shrink:0;}
/* Learning hub sidebar (keeps off-canvas) */
.learning-hub-sidebar{position:fixed;top:0;right:-100%;width:100%;max-width:500px;height:100vh;background:white;z-index:1000;box-shadow:-5px 0 15px rgba(0,0,0,0.1);transition:right 0.25s ease;overflow-y:auto;padding:20px;}
.learning-hub-sidebar.active{right:0;}
.sidebar-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid #eee;}
.close-sidebar{background:none;border:none;font-size:1.4rem;cursor:pointer;color:var(--text-light);}
.daily-tip-card{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-light) 100%);color:white;border-radius:12px;padding:18px;position:relative;margin-bottom:18px;}
.progress-section{display:flex;align-items:center;gap:10px;margin:20px 0;padding:15px;background:#f9f9f9;border-radius:12px;}
.lesson-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;}