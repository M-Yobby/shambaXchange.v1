// js/dashboard.js - restored dashboard functionality + Learning Hub + Sales History
// Heavily commented for debugging and clarity.

const sampleCrops = [
  {name:'Maize', progress:75, img:'https://images.unsplash.com/photo-1626808642875-0aa54583dedb?auto=format&fit=crop&w=300&q=80'},
  {name:'Avocado', progress:40, img:'https://images.unsplash.com/photo-1598034981849-8a4a99a6043c?auto=format&fit=crop&w=300&q=80'},
  {name:'Beans', progress:90, img:'https://images.unsplash.com/photo-1592417817098-8fd3d9eb14a5?auto=format&fit=crop&w=300&q=80'}
];

function renderCrops(){
  const list = document.getElementById('crop-list');
  if(!list) return;
  list.innerHTML = '';
  sampleCrops.forEach(c=>{
    const div = document.createElement('div');
    div.className = 'crop-item';
    div.innerHTML = `
      <div class="crop-info">
        <img src="${c.img}" alt="${c.name}" class="crop-image"/>
        <div>
          <div class="crop-name">${c.name}</div>
          <div class="crop-progress"><div class="progress-bar" style="width:${c.progress}%;background-color:var(--primary)"></div></div>
        </div>
      </div>
      <div class="crop-status">${c.progress}%</div>
    `;
    list.appendChild(div);
  });
}

function renderQuickActions(){
  const container = document.getElementById('quick-actions');
  if(!container) return;
  container.innerHTML = '';
  const actions = [
    {icon:'fas fa-coins',label:'Record Sale',id:'action-record-sale'},
    {icon:'fas fa-chart-line',label:'Check Prices',id:'action-check-prices'},
    {icon:'fas fa-question-circle',label:'Ask Question',id:'action-ask-question'},
    {icon:'fas fa-graduation-cap',label:'Learning Hub',id:'action-learning-hub'}
  ];
  actions.forEach(a=>{
    const btn = document.createElement('button');
    btn.className = 'action-btn';
    btn.id = a.id;
    btn.innerHTML = `<i class="${a.icon}"></i><span>${a.label}</span>`;
    container.appendChild(btn);
  });

  // Wire actions
  document.getElementById('action-learning-hub')?.addEventListener('click', ()=>{
    const sidebar = document.getElementById('learning-hub-sidebar');
    const overlay = document.getElementById('overlay-bg');
    if(sidebar){ sidebar.classList.add('active'); overlay?.classList.add('active'); document.body.style.overflow='hidden'; }
  });

  // Check Prices navigates to market intelligence (resolved by app.js)
  document.getElementById('action-check-prices')?.addEventListener('click', ()=>{
    // navigate using relative resolution
    window.location.href = new URL('../views/market.html', window.location.href).href;
  });

  // Record Sale opens modal
  document.getElementById('action-record-sale')?.addEventListener('click', ()=>{
    document.getElementById('sales-overlay').style.display = 'block';
    document.getElementById('sales-modal').style.display = 'flex';
  });
}

function renderRecommendations(){
  const rec = document.getElementById('recommendations');
  if(!rec) return;
  rec.innerHTML = `
    <div class="recommendation">
      <div class="recommendation-icon"><i class="fas fa-tint"></i></div>
      <div class="recommendation-content"><h3>Irrigation Adjustment</h3><p>Reduce irrigation by 20% for the next 3 days to prevent waterlogging.</p></div>
    </div>
    <div class="recommendation">
      <div class="recommendation-icon"><i class="fas fa-shopping-cart"></i></div>
      <div class="recommendation-content"><h3>Market Opportunity</h3><p>Current avocado prices in Nairobi are 15% above average. Consider prioritizing harvest.</p></div>
    </div>
  `;
}

// Sales storage utilities (persist across refresh)
function getSales(){ return JSON.parse(localStorage.getItem('sx_sales') || '[]'); }
function saveSales(sales){ localStorage.setItem('sx_sales', JSON.stringify(sales)); }

function renderSales(){
  const root = document.getElementById('sales-list');
  if(!root) return;
  const sales = getSales();
  if(sales.length===0){ root.innerHTML = '<p style="color:var(--text-light)">No sales recorded yet.</p>'; return; }
  root.innerHTML = '';
  sales.slice().reverse().forEach((s,idx)=>{
    const d = document.createElement('div');
    d.className = 'recommendation';
    d.innerHTML = `<div class="recommendation-icon"><i class="fas fa-dollar-sign"></i></div>
      <div class="recommendation-content"><strong>${s.product}</strong> — ${s.quantity} ${s.units} @ KES ${s.price} <br/><small>Buyer: ${s.buyer || '-'} | ${s.location || '-'} | ${s.date || '-'}</small></div>
      <div style="margin-left:12px;"><button class="btn" data-delete="${s.createdAt}">Delete</button></div>`;
    root.appendChild(d);
  });
  // wire delete buttons
  root.querySelectorAll('button[data-delete]').forEach(b=>{
    b.addEventListener('click', ()=>{
      const key = b.getAttribute('data-delete');
      const filtered = getSales().filter(s=>s.createdAt !== key);
      saveSales(filtered);
      renderSales(); populateFilterProducts(); handleFilter();
    });
  });
}

// Sales form handling
document.addEventListener('DOMContentLoaded', function(){
  try{
    renderCrops();
    renderQuickActions();
    renderRecommendations();
    renderSales(); populateFilterProducts(); handleFilter();
  }catch(e){ console.error('Dashboard init error', e); }

  // Sales modal form submit
  document.getElementById('sales-form')?.addEventListener('submit', (e)=>{
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.target));
    const sales = getSales();
    const record = {...data, createdAt: new Date().toISOString()};
    if(!record.date) record.date = new Date().toISOString().slice(0,10);
    sales.push(record);
    saveSales(sales);
    // close modal and refresh sales list
    document.getElementById('sales-overlay').style.display = 'none';
    document.getElementById('sales-modal').style.display = 'none';
    renderSales(); populateFilterProducts(); handleFilter();
  });

  // cancel sales modal
  document.getElementById('cancel-sales')?.addEventListener('click', ()=>{
    document.getElementById('sales-overlay').style.display = 'none';
    document.getElementById('sales-modal').style.display = 'none';
  });

  // clear all sales
  document.getElementById('clear-sales')?.addEventListener('click', (e)=>{
    e.preventDefault();
    if(confirm('Clear all sales history?')){ localStorage.removeItem('sx_sales'); renderSales(); populateFilterProducts(); handleFilter(); }
  });

  // close learning hub via overlay or close button
  document.addEventListener('click', function(e){
    if(e.target.id==='overlay-bg' || e.target.closest('.close-sidebar')){
      const sidebar = document.getElementById('learning-hub-sidebar');
      const overlay = document.getElementById('overlay-bg');
      if(sidebar) sidebar.classList.remove('active');
      if(overlay) overlay.classList.remove('active');
      document.body.style.overflow='auto';
    }
  });
});


// Populate product dropdown
function populateFilterProducts(){
  const sales = getSales();
  const products = [...new Set(sales.map(s=>s.product).filter(Boolean))];
  const sel = document.getElementById('filter-product');
  if(!sel) return;
  sel.innerHTML = '<option value="">All</option>';
  products.forEach(p=>{
    const opt = document.createElement('option');
    opt.value = p; opt.textContent = p;
    sel.appendChild(opt);
  });
}

// Handle filter form
function handleFilter(){
  const form = document.getElementById('sales-filter-form');
  const out = document.getElementById('filter-results');
  if(!form||!out) return;
  form.addEventListener('submit', (e)=>{
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    const start = data.start? new Date(data.start): null;
    const end = data.end? new Date(data.end): null;
    const product = data.product || '';
    const sales = getSales();
    const filtered = sales.filter(s=>{
      const d = new Date(s.date||s.createdAt);
      if(start && d<start) return false;
      if(end && d>end) return false;
      if(product && s.product!==product) return false;
      return true;
    });
    if(filtered.length===0){ out.innerHTML='<p style="color:var(--text-light)">No matching sales.</p>'; return; }
    out.innerHTML = '';
    filtered.forEach(s=>{
      const dEl = document.createElement('div');
      dEl.className='recommendation';
      dEl.innerHTML = `<div class="recommendation-icon"><i class="fas fa-dollar-sign"></i></div>
        <div class="recommendation-content"><strong>${s.product}</strong> — ${s.quantity} ${s.units} @ KES ${s.price} <br/><small>${s.date}</small></div>`;
      out.appendChild(dEl);
    });
  });
}
