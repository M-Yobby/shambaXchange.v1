<!-- views/dashboard.html -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Dashboard - ShambaXchange</title>
  <link rel="stylesheet" href="../styles/main.css">
  <link rel="stylesheet" href="../styles/dashboard.css">
  <link rel="stylesheet" href="../styles/responsive.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<header><a href=\"farmer_dashboard/dashboard.html">Farm Dashboard</a></header>

  <div id="header-root"></div>

  <main class="container main-content">
    <section id="dashboard" class="page-section active">
      <div class="page-title">
        <div class="welcome-message">
          <h1 id="greeting">Good morning!</h1>
          <div class="location"><i class="fas fa-map-marker-alt"></i> <span id="user-location">Busia County, Kenya</span></div>
        </div>
        <div>
          <!-- keep New Listing removed as requested; actions live in quick actions -->
        </div>
      </div>

      <div class="weather-alert" id="weather-alert">
        <div class="weather-alert-content">
          <div class="weather-icon"><i class="fas fa-cloud-rain"></i></div>
          <div class="weather-details">
            <h3>Heavy Rainfall Expected</h3>
            <p>Tomorrow: 80% chance of heavy rain. Consider delaying harvest activities.</p>
          </div>
        </div>
        <a href="#" class="weather-link">See full forecast <i class="fas fa-arrow-right"></i></a>
      </div>

      <div class="dashboard-grid">
        <!-- Crop Progress Card -->
        <div class="card" id="crop-progress-card">
          <div class="card-header">
            <h2 class="card-title"><i class="fas fa-seedling"></i> Crop Progress</h2>
            <a href="#" id="view-all-crops">View All</a>
          </div>
          <div id="crop-list"></div>
        </div>

        <!-- Quick Actions -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title"><i class="fas fa-bolt"></i> Quick Actions</h2>
          </div>
          <div class="quick-actions" id="quick-actions">
            <!-- buttons created by JS -->
          </div>
        </div>

        <!-- AI Recommendations -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title"><i class="fas fa-robot"></i> AI Recommendations</h2>
          </div>
          <div id="recommendations"></div>
        </div>

        <!-- Sales History (new card) -->
        <div class="card" id="sales-history-card">
          <div class="card-header"><h2 class="card-title"><i class="fas fa-receipt"></i> Sales History <a href="#" id="clear-sales" style="float:right;font-size:0.9rem;color:var(--text-light)">Clear</a></h2></div>
          <div id="sales-list"></div>
        
        <!-- Sales Filter Card -->
        <div class="card" id="sales-filter-card">
          <div class="card-header"><h2 class="card-title"><i class="fas fa-filter"></i> Filter Sales Records</h2></div>
          <div style="padding:12px;">
            <form id="sales-filter-form" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;">
              <label>Start Date <input type="date" name="start"></label>
              <label>End Date <input type="date" name="end"></label>
              <label>Product <select name="product" id="filter-product"><option value="">All</option></select></label>
              <button class="btn btn-primary" type="submit">Filter</button>
            </form>
            <div id="filter-results" style="margin-top:12px;"></div>
          </div>
        </div>
</div>
      </div>
    </section>
  </main>

  <!-- Learning Hub Sidebar and Overlay -->
  <div class="learning-hub-sidebar" id="learning-hub-sidebar">
    <div class="sidebar-header">
      <h2>Learning Hub</h2>
      <button class="close-sidebar"><i class="fas fa-times"></i></button>
    </div>
    <div class="daily-tip-card">
      <h3>Daily Tip</h3>
      <p>Rotate your maize with legumes to improve soil fertility naturally.</p>
    </div>
    <div class="lesson-grid">
      <div class="card"><h4>Pest Control Basics</h4><p>Learn integrated pest management methods.</p></div>
      <div class="card"><h4>Soil Management</h4><p>Proper soil preparation increases yields.</p></div>
    </div>
  </div>
  <div class="overlay-bg" id="overlay-bg"></div>

  <!-- Sales Form Modal -->
  <div class="overlay-bg" id="sales-overlay" style="display:none"></div>
  <div id="sales-modal" style="display:none;position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:2000;">
    <div style="background:white;padding:20px;border-radius:12px;max-width:520px;width:100%;box-shadow:0 8px 24px rgba(0,0,0,0.2)">
      <h3>Record Sale</h3>
      <form id="sales-form">
        <label>Product <input name="product" required></label>
        <label>Quantity <input type="number" name="quantity" required></label>
        <label>Units <select name="units"><option>kgs</option><option>bags</option><option>litres</option><option>tonnes</option><option>units</option></select></label>
        <label>Price (KES) <input type="number" name="price" required></label>
        <label>Buyer Name <input name="buyer"></label>
        <label>Location <input name="location"></label>
        <label>Date <input type="date" name="date"></label>
        <div style="display:flex;gap:10px;margin-top:12px;">
          <button class="btn btn-primary" type="submit">Save Sale</button>
          <button type="button" class="btn" id="cancel-sales">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <div id="footer-root"></div>

  <script type="module" src="../js/app.js"></script>
  <script type="module" src="../js/dashboard.js"></script>
</body>
</html>
